.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Full Raw Dataset (7,000+ images, 150MB+; use sample_scans/ for offline test or download via README Kaggle link)
Dataset/
brain-tumor-mri-dataset/

# Large Model Checkpoints exceeding GitHub 100MB limit
# ViT-B/16 is 328MB. Download via Google Drive / Hugging Face links or train in Google Colab (notebooks/Brain_Tumor_Colab_Training.ipynb).
models/*vit*.pth
models/best_*.pth

# Keep lightweight checkpoints (<50MB) in repo for instant out-of-the-box inference:
# !models/custom_cnn_final_model.pth (5.5MB)
# !models/mobilenet_v3_final_model.pth (4.2MB)
# !models/resnet18_final_model.pth (43.2MB)

# Test / tooling caches
.pytest_cache/
.ruff_cache/

# Atomic checkpoint writes (see src/models.py save_checkpoint)
*.pth.tmp

# Logs & temp files
*.log
scratch/
temp/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor configuration
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Self-hosted ViT export (~330 MB) must never be committed (GitHub 100 MB limit)
models/onnx/*vit*.onnx
*.onnx.tmp
